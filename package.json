{
  "name": "supersecretrecipewebsite",
  "version": "0.1.0",
  "description": "Recipe platform — Phase 1 (see docs/2026-07-18-recipe-platform-design.md)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/unit --config ./vitest.config.mts",
    "fix:ingredient-rows": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/fixIngredientRows.ts",
    "build:usda": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/import/buildUsdaNutrition.ts",
    "review:ingredients": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/reviewIngredients.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/seed/run.ts",
    "seed:nutrition": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/import/seedNutrition.ts",
    "compute:nutrition": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/import/computeNutrition.ts",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed:cuisines": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/seed/worldCuisines.ts",
    "seed:grocery": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/seed/groceryRetailers.ts",
    "seed:cook-depth": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/seedCookDepth.ts",
    "icons": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/buildAppIcons.ts",
    "email:test": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/sendTestEmail.ts",
    "fetch:logos": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/fetchShopLogos.ts",
    "verify:grocery": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/verifyGroceryRetailers.ts",
    "audit:recipes": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/auditRecipes.ts",
    "remaster:heroes": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/remasterHeroes.ts",
    "fix:fossil-names": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/fixFossilNames.ts",
    "clean:ingredients": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/cleanIngredientNames.ts",
    "normalize:catalog": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/normalizeCatalog.ts",
    "seed:constraints": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/seedConstraints.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jspdf": "^4.2.1",
    "next": "16.2.12",
    "payload": "3.86.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.19",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3",
    "stripe": "^22.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.34.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
