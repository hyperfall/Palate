# Postgres. Payload pushes schema automatically in development.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/recipes_dev

# Any long random string. Rotating it invalidates existing admin sessions.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Canonical origin. Used for canonical URLs, OG tags, and sitemap.xml.
# Must be the real public origin in production, or the sitemap ships localhost links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, media uploads go to Vercel Blob instead of local disk (§4).
# BLOB_READ_WRITE_TOKEN=

# Optional. If both are set, `npm run seed` creates this admin user.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=

# Supabase — accounts, planning, subscriptions, households (Settings → API).
# After creating the project, run supabase/schema.sql in the SQL editor once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (Settings → API → service_role). Server-only — writes the
# rows RLS forbids the client (Stripe webhook subscriptions, household create).
# NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email — creator notifications (Resend: resend.com → API Keys).
# Approval and rejection of a studio submission mail the creator. The studio
# promises "a person checks every recipe"; without this they never hear the
# verdict. Unset is safe: messages are logged to the server console instead and
# an approval can never fail because the mailer is missing.
RESEND_API_KEY=
# The From address. Must be on a domain verified in Resend, or sending 403s.
EMAIL_FROM=Palate <hello@yourdomain.com>

# Google Analytics 4 (dashboard → Admin → Data Streams → Measurement ID).
# Consent-gated: GA only loads after a visitor opts into Analytics cookies, and
# stays completely dormant while this is unset. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Stripe — supporter subscription (dashboard → Developers). All optional; the
# supporter tier stays hidden and un-buyable until secret key + price are set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_SUPPORTER=
# Webhook signing secret for /api/stripe/webhook (Developers → Webhooks, or the
# Stripe CLI's `stripe listen`). The webhook is the only writer of subscriptions.
STRIPE_WEBHOOK_SECRET=
# Price shown on the /support page (display only). Default "£3.50/month".
NEXT_PUBLIC_SUPPORTER_PRICE_LABEL=

# Grocery "Shop this list" — viewer country fallback when the Vercel geo header
# is absent (local dev, some proxies). ISO-2, default GB.
GROCERY_DEFAULT_COUNTRY=GB
