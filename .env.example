# Postgres. Payload pushes schema automatically in development.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/recipes_dev

# Any long random string. Rotating it invalidates existing admin sessions.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Canonical origin. Used for canonical URLs, OG tags, and sitemap.xml.
# Must be the real public origin in production, or the sitemap ships localhost links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, media uploads go to Vercel Blob instead of local disk (§4).
# BLOB_READ_WRITE_TOKEN=

# Optional. If both are set, `npm run seed` creates this admin user.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=

# Supabase — accounts + saved-recipe collections (dashboard → Settings → API).
# After creating the project, run supabase/schema.sql in the SQL editor once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 (dashboard → Admin → Data Streams → Measurement ID).
# Consent-gated: GA only loads after a visitor opts into Analytics cookies, and
# stays completely dormant while this is unset. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Hybrid recipe import (`npm run import:recipes`, auto-runs with `npm run dev`).
# Spoonacular = content source (instructions, ingredients, nutrition, cost).
# Get a key at https://spoonacular.com/food-api/console (free: 150 points/day).
SPOONACULAR_API_KEY=

# Edamam = photo source, matched by dish title (falls back to Spoonacular
# images when unset/absent). https://developer.edamam.com (free: 10 calls/min;
# the FIRST sweep downloads every photo and takes ~25 min in the background).
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Optional: recipes fetched per cuisine (default 10).
# SPOONACULAR_PER_CUISINE=10
